# SQLite database file. Relative paths resolve from the process working directory.
# Use a persistent local filesystem; network filesystems and multiple app replicas are unsupported.
DATABASE_URL=./data/ledgerlab.db

# Receipt files default to an `attachments` directory beside the SQLite database.
# Set an absolute path only when that directory is separately persisted and backed up.
# ATTACHMENTS_DIR=./data/attachments
# ATTACHMENT_MAX_FILE_BYTES=10485760
# ATTACHMENT_USER_QUOTA_BYTES=262144000
# ATTACHMENT_MAX_FILES_PER_TRANSACTION=10

# Who may create users: first-user (default), open, or closed.
# `first-user` allows one initial owner, then closes registration automatically.
REGISTRATION_MODE=first-user

# Optional Next.js production server settings.
# HOSTNAME=127.0.0.1
# PORT=3000
# NEXT_TELEMETRY_DISABLED=1

# Used only by `npm run db:seed`. Keep unset unless intentionally creating demo data.
# DEMO_PASSWORD=replace-with-an-explicit-password-of-at-least-10-characters
